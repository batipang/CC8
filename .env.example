# Optional non-secret overrides; this file is documentation, not auto-loaded.
# Environment > selected owner-private JSON profile > repository defaults.
# Do not place API keys, tokens or signing-key contents in this file/profile.
# Existing MiniMax secrets stay in the owner-only voice-secrets.env storage.

# CC8_CONFIG_FILE=/absolute/path/to/private-assistant.json
# CC8_ASR_ENGINE=minimax
# CC8_VOICE_MODE=minimax
# CC8_GPT_LIVE_VOICE=marin
# CC8_BRAIN_PROVIDER=dot
# CC8_MINIMAX_BASE=https://api.minimax.cn
# CC8_MINIMAX_MODEL=MiniMax-M3
# CC8_ASR_MODEL=asr-1.0
# CC8_TTS_MODEL=speech-2.8-turbo
# CC8_TTS_VOICE="Chinese (Mandarin)_Straightforward_Boy"
# CC8_TTS_SPEED=1.03
# CC8_TTS_PITCH=1
# CC8_TTS_EMOTION=none
# CC8_TLS_PORT=18766
# CC8_CONNECT_TIMEOUT=8
# CC8_READ_TIMEOUT=20
# CC8_MINIMAX_CREDENTIAL_FILE=/absolute/path/to/owner-only-voice-secrets.env
# CC8_SIGNING_KEYSTORE=/absolute/path/to/original-signing.jks

# Bounded conversation after a local wake (15–300 seconds).
# CC8_WAKE_WINDOW_SECONDS=60

# Optional local confirmation for wider English wake candidates; default off.
# Requires the pinned local Whisper snapshot; does not change MiniMax ASR.
# CC8_ENGLISH_WAKE_VERIFIER=whisper_complete

# Optional paired-reference prototype; mono remains the default.
# Enable paired only with a validated device and mutually supporting peers.
# CC8_CAPTURE_FRONTEND=mono
